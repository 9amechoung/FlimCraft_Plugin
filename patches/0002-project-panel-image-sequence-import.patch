+/// The frame Import Image Sequence… starts from when the dialog returns `paths`: the lowest-numbered
+/// still among them, so picking one frame, or every frame with Select All, imports the whole run.
+/// A path without a frame number comes last (the import then reports it).
+fn first_numbered_frame(paths: Vec<String>) -> Option<String> {
+    paths.into_iter().min_by_key(|p| filmcraft_media::sequence::Numbered::parse(p).map_or(u64::MAX, |n| n.number))
+}
+
+#[cfg(test)]
+mod first_numbered_frame_tests {
+    use super::first_numbered_frame;
+
+    #[test]
+    fn the_lowest_frame_of_a_selection_starts_the_sequence() {
+        let v = |a: &[&str]| a.iter().map(|s| s.to_string()).collect::<Vec<_>>();
+        assert_eq!(first_numbered_frame(v(&[])), None);
+        assert_eq!(first_numbered_frame(v(&["C:/shots/plate_0007.png"])).as_deref(), Some("C:/shots/plate_0007.png"));
+        // Select All in the dialog: the order it returns them in does not matter
+        let all = v(&["C:/shots/plate_0003.png", "C:/shots/plate_0010.png", "C:/shots/plate_0001.png", "C:/shots/plate_0002.png"]);
+        assert_eq!(first_numbered_frame(all).as_deref(), Some("C:/shots/plate_0001.png"));
+        // unpadded numbers compare as numbers, not text
+        assert_eq!(first_numbered_frame(v(&["/s/f10.exr", "/s/f9.exr"])).as_deref(), Some("/s/f9.exr"));
+        assert_eq!(first_numbered_frame(v(&["/s/cover.png", "/s/f2.png"])).as_deref(), Some("/s/f2.png"));
+    }
+}
