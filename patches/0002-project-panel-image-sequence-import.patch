+/// Import Image Sequence… from the Project panel: the footer button, the empty-space right-click
+/// menu, Alt+double-click on empty space and its shortcut each open the stills-only dialog and
+/// import into the bin the panel shows. The dialog returns every frame, last first (Select All);
+/// the sequence still starts at frame 1. A plain double-click keeps opening Import….
+#[test]
+fn import_image_sequence_from_the_project_panel() {
+    let dir = std::env::temp_dir().join(format!("fc-ui-imgseq-panel-{}", std::process::id()));
+    std::fs::create_dir_all(&dir).unwrap();
+    let mut frames: Vec<String> = (1..=5)
+        .map(|n| {
+            let p = dir.join(format!("plate_{n:04}.png"));
+            image::RgbaImage::from_pixel(16, 9, image::Rgba([n as u8 * 40, 0, 0, 255])).save(&p).unwrap();
+            p.to_string_lossy().to_string()
+        })
+        .collect();
+    frames.reverse();
+
+    let mut session = Session::default();
+    let plates = filmcraft_project::BinId(session.execute("file.newBin", json!({"name": "Plates"})).unwrap()["bin"].as_u64().unwrap());
+    let (tx, rx) = channel();
+    let mut app = FilmcraftApp::new(session).with_control(rx);
+    app.ui.project_panel.bin = Some(plates.0);
+    // which dialog opened: "sequence" (stills only) or "import" (movies too)
+    let opened = std::sync::Arc::new(std::sync::Mutex::new(Vec::<&'static str>::new()));
+    let seen = opened.clone();
+    app.hooks.pick_files = Some(Box::new(move |exts| {
+        let sequence = !exts.contains(&"mp4");
+        seen.lock().unwrap().push(if sequence { "sequence" } else { "import" });
+        if sequence { frames.clone() } else { Vec::new() }
+    }));
+    let harness = Harness::builder().with_size(egui::vec2(1600.0, 980.0)).with_step_dt(1.0 / 60.0).with_max_steps(10_000).build_eframe(move |_cc| app);
+    let mut d = Driver { harness, tx, snapshots: None };
+    d.ok("ui.panel.show", json!({"panel": "Project"}));
+    d.ok("ui.set", json!({"focused": "Project"}));
+    d.frames(10);
+    // (dialogs opened so far, the last one)
+    let opened_so_far = || {
+        let o = opened.lock().unwrap();
+        (o.len(), o.last().copied())
+    };
+    let sequences = |d: &mut Driver| -> Vec<ItemId> {
+        let bin = d.app().session.project.root.find_bin(plates).unwrap().clone();
+        bin.children
+            .iter()
+            .filter_map(|e| if let BinEntry::Item(i) = e { Some(*i) } else { None })
+            .filter(|i| d.app().session.project.item(*i).and_then(|it| it.as_media()).is_some_and(|m| m.info.kind == filmcraft_media::MediaKind::ImageSequence))
+            .collect()
+    };
+    let press = |d: &mut Driver, at: egui::Pos2, button: egui::PointerButton, modifiers: egui::Modifiers, times: usize| {
+        d.frames(60);
+        d.harness.input_mut().events.extend([egui::Event::ModifiersChanged(modifiers), egui::Event::PointerMoved(at)]);
+        d.frames(1);
+        for _ in 0..times {
+            for pressed in [true, false] {
+                d.harness.input_mut().events.push(egui::Event::PointerButton { pos: at, button, pressed, modifiers });
+                d.frames(1);
+            }
+        }
+        d.harness.input_mut().events.push(egui::Event::ModifiersChanged(egui::Modifiers::NONE));
+        d.frames(3);
+    };
+
+    // the footer button
+    d.click("project.button.file.importImageSequence");
+    assert_eq!(opened_so_far().1, Some("sequence"));
+    let got = sequences(&mut d);
+    assert_eq!(got.len(), 1, "imported into the shown bin");
+    let m = d.app().session.project.item(got[0]).unwrap().as_media().unwrap().clone();
+    assert_eq!(m.info.duration, m.info.frame_rate().tick_of(5), "all five frames, from the lowest number");
+
+    // right-click empty space ▸ Import Image Sequence…
+    let r = d.rect("project.empty");
+    let empty = egui::pos2(r[0] + r[2] / 2.0, r[1] + r[3] / 2.0);
+    press(&mut d, empty, egui::PointerButton::Secondary, egui::Modifiers::NONE, 1);
+    d.wait_for("project.menu.importImageSequence");
+    d.click("project.menu.importImageSequence");
+    assert_eq!(sequences(&mut d).len(), 2);
+
+    // Alt+double-click empty space; a plain double-click is still Import…
+    let n = opened_so_far().0;
+    press(&mut d, empty, egui::PointerButton::Primary, egui::Modifiers::ALT, 2);
+    assert_eq!(opened_so_far(), (n + 1, Some("sequence")));
+    assert_eq!(sequences(&mut d).len(), 3);
+    press(&mut d, empty, egui::PointerButton::Primary, egui::Modifiers::NONE, 2);
+    assert_eq!(opened_so_far(), (n + 2, Some("import")));
+
+    // the shortcut
+    d.key("Cmd+Alt+Shift+I");
+    assert_eq!(opened_so_far().1, Some("sequence"));
+    assert_eq!(sequences(&mut d).len(), 4);
+    let _ = std::fs::remove_dir_all(&dir);
+}
