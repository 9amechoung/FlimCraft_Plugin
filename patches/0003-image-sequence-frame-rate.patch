+
+/// `frameRate` on File ▸ Import Image Sequence…: the sequence plays at the chosen rate (stop-motion
+/// at 12 fps no longer runs at the 29.97 default), keeps it after save and reopen, and fills its
+/// timeline clip for the right length. Out-of-range rates are refused.
+#[test]
+fn image_sequence_imports_at_the_chosen_frame_rate() {
+    let dir = tmp_dir("imgseq-rate");
+    let mut s = demo();
+    let paths = write_frames(&dir, "anim_", &[1, 2, 3, 4, 5, 6], "png");
+    let r = s.execute("file.importImageSequence", json!({"path": paths[0], "frameRate": 12})).unwrap();
+    let id = item_of(&r);
+    let m = s.project.item(id).unwrap().as_media().unwrap().clone();
+    assert_eq!(m.info.frame_rate(), FrameRate::new(12, 1));
+    assert_eq!(m.info.duration, filmcraft_time::Tick::from_seconds_f64(0.5), "6 frames at 12 fps");
+    assert_eq!(red_at(&s, id, 5), 60);
+    let end = s.active_sequence().unwrap().duration();
+    let r = s.execute("timeline.place", json!({"item": id.0, "track": "V1", "time": end.0})).unwrap();
+    let clip = ClipId(r["clips"][0].as_u64().unwrap());
+    let dur = s.active_sequence().unwrap().find_item(clip).unwrap().1.duration;
+    assert_eq!(dur, s.sequence_rate().snap_nearest(m.info.duration), "{dur:?}");
+    // NTSC rates as written, as text too, and through File ▸ Import
+    for (v, want) in [(json!(23.976), FrameRate::FPS_23_976), (json!("29.97"), FrameRate::FPS_29_97), (json!(12.5), FrameRate::new(25, 2))] {
+        let r = s.execute("file.import", json!({"paths": [paths[0]], "imageSequence": true, "frameRate": v})).unwrap();
+        assert_eq!(s.project.item(item_of(&r)).unwrap().as_media().unwrap().info.frame_rate(), want, "{v}");
+    }
+    for v in [json!(0), json!(-5), json!(1000), json!("fast")] {
+        let e = s.execute("file.importImageSequence", json!({"path": paths[0], "frameRate": v})).unwrap_err().to_string();
+        assert!(e.contains("frameRate"), "{e}");
+    }
+    // the rate is the item's: it survives save and reopen
+    let proj = dir.join("rate.fcproj");
+    s.execute("file.saveAs", json!({"path": proj.to_string_lossy()})).unwrap();
+    let mut t = Session::default();
+    t.execute("file.open", json!({"path": proj.to_string_lossy()})).unwrap();
+    assert_eq!(t.project.item(id).unwrap().as_media().unwrap().info.frame_rate(), FrameRate::new(12, 1));
+    let src = t.media.source_for(&t.project, id, &*t.services).unwrap();
+    assert_eq!(src.info().frame_rate(), FrameRate::new(12, 1));
+    assert_eq!(red_at(&t, id, 3), 40);
+    let _ = std::fs::remove_dir_all(&dir);
+}
