+/// `frameRate`: the rate an imported image sequence plays at (frames per second, e.g. 12 or
+/// 23.976). Absent is `None` (Settings ▸ Media ▸ Indeterminate Media Timebase).
+pub(crate) fn sequence_rate_p(p: &Value, cmd: &str) -> Result<Option<FrameRate>> {
+    let v = match p.get("frameRate") {
+        None | Some(Value::Null) => return Ok(None),
+        Some(v) => v,
+    };
+    match v.as_f64().or_else(|| v.as_str().and_then(|t| t.trim().trim_end_matches("df").trim_end_matches("fps").trim().parse().ok())) {
+        Some(fps) if (1.0..=240.0).contains(&fps) => Ok(Some(FrameRate::from_f64(fps))),
+        _ => Err(bad(cmd, format!("frameRate must be 1 to 240 frames per second, got {v}"))),
+    }
+}
