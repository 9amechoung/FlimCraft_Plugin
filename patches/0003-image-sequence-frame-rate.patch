diff --git a/crates/ui-egui/src/panels/image_sequence_dialog.rs b/crates/ui-egui/src/panels/image_sequence_dialog.rs
new file mode 100644
index 00000000..0efffef7
--- /dev/null
+++ b/crates/ui-egui/src/panels/image_sequence_dialog.rs
@@ -0,0 +1,76 @@
+//! Import Image Sequence… ▸ frame rate. Stills carry no frame rate, so once the first frame is
+//! chosen this asks the rate the sequence plays at (12 fps animation played at the 29.97 default
+//! looks fast-forwarded), then runs `file.importImageSequence` with `frameRate` on OK. It starts
+//! from the rate chosen last in this run, else Settings ▸ Media ▸ Indeterminate Media Timebase.
+//!
+//! Automation ids: `imageSequence.fps` (any rate), `imageSequence.preset.<fps>` (e.g.
+//! `imageSequence.preset.12`, `imageSequence.preset.23.976`), `imageSequence.ok`,
+//! `imageSequence.cancel`.
+
+use serde_json::json;
+
+use crate::FilmcraftApp;
+
+/// The rates offered as one-click choices: animation and stop-motion rates, then the video ones.
+pub const PRESETS: [f64; 14] = [8.0, 10.0, 12.0, 12.5, 15.0, 23.976, 24.0, 25.0, 29.97, 30.0, 48.0, 50.0, 59.94, 60.0];
+
+/// The rate the dialog starts from before one is chosen: Indeterminate Media Timebase.
+pub fn default_fps(app: &FilmcraftApp) -> f64 {
+    let r = filmcraft_engine::settings::timebase_rate(&app.session.prefs.media.indeterminate_timebase);
+    (r.as_f64() * 1000.0).round() / 1000.0
+}
+
+pub fn show(app: &mut FilmcraftApp, ctx: &egui::Context) {
+    let Some(mut d) = app.ui.image_sequence_import.clone() else { return };
+    let mut elems: Vec<(String, egui::Rect, String)> = Vec::new();
+    let (mut ok, mut cancel) = (false, false);
+    let name = std::path::Path::new(&d.path).file_name().map_or_else(|| d.path.clone(), |n| n.to_string_lossy().to_string());
+    let n = d.frames;
+    egui::Window::new(tl!("Import Image Sequence"))
+        .id(egui::Id::new("Import Image Sequence"))
+        .collapsible(false)
+        .resizable(false)
+        .pivot(egui::Align2::CENTER_CENTER)
+        .default_pos(crate::widgets::dialog_center(ctx))
+        .default_width(360.0)
+        .show(ctx, |ui| {
+            ui.label(egui::RichText::new(tlf!("{name}: {n} frames", name, n)).strong());
+            ui.label(tl!("Stills have no frame rate of their own. Choose the rate the frames were made at."));
+            ui.add_space(4.0);
+            ui.horizontal(|ui| {
+                ui.label(tl!("Frame Rate"));
+                let r = ui.add(egui::DragValue::new(&mut d.fps).range(1.0..=240.0).speed(0.05).max_decimals(3).suffix(" fps"));
+                elems.push(("imageSequence.fps".into(), r.rect, "Frame Rate".into()));
+            });
+            ui.horizontal_wrapped(|ui| {
+                for p in PRESETS {
+                    let r = ui.selectable_label((d.fps - p).abs() < 0.0005, p.to_string());
+                    if r.clicked() {
+                        d.fps = p;
+                    }
+                    elems.push((format!("imageSequence.preset.{p}"), r.rect, format!("{p} fps")));
+                }
+            });
+            let secs = format!("{:.2}", n as f64 / d.fps.max(1.0));
+            ui.label(tlf!("Duration: {secs} s", secs));
+            ui.add_space(6.0);
+            ui.horizontal(|ui| {
+                let r = ui.button(tl!("Cancel"));
+                elems.push(("imageSequence.cancel".into(), r.rect, "Cancel".into()));
+                cancel = r.clicked();
+                let r = ui.button(tl!("OK"));
+                elems.push(("imageSequence.ok".into(), r.rect, "OK".into()));
+                ok = r.clicked();
+            });
+        });
+    for (id, r, l) in elems {
+        app.auto.add(&id, r, &l);
+    }
+    if ok {
+        app.ui.image_sequence_fps = Some(d.fps);
+        if let Err(e) = app.session.execute("file.importImageSequence", json!({"path": d.path, "bin": d.bin, "frameRate": d.fps})) {
+            app.ui.status = e.to_string();
+        }
+    }
+    app.ui.image_sequence_import = (!ok && !cancel && !crate::widgets::escape_closes(ctx)).then_some(d);
+}
